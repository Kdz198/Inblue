@startuml SendPasswordResetOtp
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 20

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

autonumber

actor "Candidate / Mentor" as User
participant ":ForgotPasswordPage" as Client
participant ":AuthController" as Controller
participant ":PasswordResetServiceImpl" as Service
participant ":UserRepository" as UserRepo
participant ":MentorRepository" as MentorRepo
participant ":RedisTemplate" as Redis
participant ":MailServiceImpl" as MailService
participant "Mail Server" as MailServer

note right of MailServer
  External SMTP mail server
end note

' ===================== Request the OTP =====================

activate Client

User -> Client : POST /api/auth/forgot-password\n(email)
Client -> Controller : POST /api/auth/forgot-password\n(email)
activate Controller

Controller -> Service : sendResetOtp(email)
activate Service

' ===================== Check that the email belongs to an account =====================

Service -> UserRepo : existsByEmail(email)
activate UserRepo
UserRepo --> Service : boolean
deactivate UserRepo

Service -> MentorRepo : findByEmail(email)
activate MentorRepo
MentorRepo --> Service : Mentor or nothing
deactivate MentorRepo

break Email does not belong to any user or mentor
    Service --> Controller : throws CustomException\n(404 NOT_FOUND, "Email does not exist in the system")
    Controller --> Client : error response (404)
    Client --> User : error response (404)
end

' ===================== Generate and store the OTP =====================

Service -> Service : generate a random 6-digit OTP

Service -> Redis : set("reset_password_otp:" + email, otp,\n5 minutes)
activate Redis
Redis --> Service : stored
deactivate Redis

' ===================== Send the OTP by email =====================

Service -> Service : build the OTP email\n(subject and HTML body)

Service -> MailService : adminSendMail(email, subject, body)
activate MailService
MailService -> MailServer : send MIME message
activate MailServer

MailServer --> MailService : accepted or delivery error
deactivate MailServer
MailService --> Service : void or throws MessagingException
deactivate MailService

break Email sending fails
    Service --> Controller : throws CustomException\n(500 INTERNAL_SERVER_ERROR, "Failed to send email, please try again later.")
    Controller --> Client : error response (500)
    Client --> User : error response (500)
end

Service --> Controller : void
deactivate Service

Controller --> Client : 200 OK\n"OTP has been sent to your email"
Client --> User : 200 OK\n"OTP has been sent to your email"
deactivate Controller

deactivate Client

@enduml
