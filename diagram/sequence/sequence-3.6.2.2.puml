@startuml JoinVideoCallRoom_MentorAssessmentSubmission
skinparam monochrome true
skinparam shadowing false

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

autonumber

actor "Candidate" as Candidate
actor "Mentor" as Mentor
participant ":StudentSessionRoomPage" as StudentPage
participant ":MentorSessionRoomPage" as MentorPage
participant "Daily.co Video API" as DailyCo
participant ":SessionController" as SessionCtrl
participant ":SessionServiceImpl" as SessionSvc
participant ":SessionRepository" as SessionRepo
participant ":MentorSessionReviewViewPage" as ReviewPage
participant ":MentorReviewController" as ReviewCtrl
participant ":MentorReviewServiceImpl" as ReviewSvc
participant ":MentorReviewRepository" as ReviewRepo

note right of DailyCo
  Third-party video conferencing service
  (not custom application code)
end note

' ===================== Both participants join the video room =====================

par Candidate joins the room
activate StudentPage
activate MentorPage
activate ReviewPage

    Candidate -> StudentPage : open the scheduled session and join the call
    StudentPage -> DailyCo : join the room (roomUrl of the session)
    activate DailyCo
    DailyCo --> StudentPage : joined-meeting event (local participant id)
    deactivate DailyCo

    StudentPage -> SessionCtrl : POST /api/sessions/join-session\n(sessionName = roomName, userId, participantId, mentor = false)
    activate SessionCtrl
    SessionCtrl -> SessionSvc : saveJoinRecord(request)
    activate SessionSvc

    SessionSvc -> SessionRepo : findByRoomName(sessionName)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo

    break Meeting room is not found
        SessionSvc --> SessionCtrl : throws CustomException\n(404 NOT_FOUND, "Meeting room not found")
        SessionCtrl --> StudentPage : error response (404)
        StudentPage --> Candidate : show error message
    end

    break Meeting room has not been approved yet
        SessionSvc --> SessionCtrl : throws CustomException\n(409 CONFLICT, "Meeting room has not been approved")
        SessionCtrl --> StudentPage : error response (409)
        StudentPage --> Candidate : show error message
    end

    break Candidate is not the candidate of this session
        SessionSvc --> SessionCtrl : throws CustomException\n(403 FORBIDDEN, "User ID does not match the session")
        SessionCtrl --> StudentPage : error response (403)
        StudentPage --> Candidate : show error message
    end

    SessionSvc -> SessionSvc : set candidate participant id,\nset session status = ONGOING and,\nif not set yet, the candidate start time
    SessionSvc -> SessionRepo : save(session)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo

    SessionSvc --> SessionCtrl : join is recorded
    deactivate SessionSvc
    SessionCtrl --> StudentPage : 200 OK
    deactivate SessionCtrl
    StudentPage --> Candidate : show the live video room
else Mentor joins the room
    Mentor -> MentorPage : open the scheduled session and join the call
    MentorPage -> DailyCo : join the room (roomUrl of the session)
    activate DailyCo
    DailyCo --> MentorPage : joined-meeting event (local participant id)
    deactivate DailyCo

    MentorPage -> SessionCtrl : POST /api/sessions/join-session\n(sessionName = roomName, mentor profile id, participantId, mentor = true)
    activate SessionCtrl
    SessionCtrl -> SessionSvc : saveJoinRecord(request)
    activate SessionSvc

    SessionSvc -> SessionRepo : findByRoomName(sessionName)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo

    break Mentor is not the mentor of this session
        SessionSvc --> SessionCtrl : throws CustomException\n(403 FORBIDDEN, "Mentor ID does not match the session")
        SessionCtrl --> MentorPage : error response (403)
        MentorPage --> Mentor : show error message
    end

    SessionSvc -> SessionSvc : set mentor participant id and,\nif not set yet, the mentor start time
    SessionSvc -> SessionRepo : save(session)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo

    SessionSvc --> SessionCtrl : join is recorded
    deactivate SessionSvc
    SessionCtrl --> MentorPage : 200 OK
    deactivate SessionCtrl
    MentorPage --> Mentor : show the live video room
end

note over Candidate, DailyCo
  The 1-on-1 interview is carried out inside the Daily.co room
  (max 2 participants, screen share and cloud recording enabled)
end note

' ===================== Leaving the room is tracked through the webhook =====================

loop For each participant who leaves the room
    DailyCo -> SessionCtrl : POST /api/sessions/webhooks/dailyco\n(participant.left: room, session id)
    activate SessionCtrl
    SessionCtrl -> SessionCtrl : map the payload to DailyWebHookPayload
    SessionCtrl -> SessionSvc : updateLeaveRecord(payload)
    activate SessionSvc

    SessionSvc -> SessionRepo : findByRoomName(roomName)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo

    break Session of this room is not found
        SessionSvc --> SessionCtrl : log the alert and stop
        SessionCtrl --> DailyCo : 200 OK
    end

    alt Leaving participant is the candidate
        SessionSvc -> SessionSvc : set candidate end time and\ncompute the candidate duration in seconds
    else Leaving participant is the mentor
        SessionSvc -> SessionSvc : set mentor end time and\ncompute the mentor duration in seconds
    end

    opt Both participants have left the room
        SessionSvc -> SessionSvc : set session status = COMPLETED
    end

    SessionSvc -> SessionRepo : save(session)
    activate SessionRepo
    SessionRepo --> SessionSvc : Session
    deactivate SessionRepo
    SessionSvc --> SessionCtrl : leave is recorded
    deactivate SessionSvc
    SessionCtrl --> DailyCo : 200 OK
    deactivate SessionCtrl
end

' ===================== Mentor submits the assessment of the candidate =====================

Mentor -> ReviewPage : POST /api/mentor-reviews\n(sessionId, mentorId, userId, rating, STAR notes,\nstrength, weakness, improvement)
ReviewPage -> ReviewCtrl : POST /api/mentor-reviews\n(sessionId, mentorId, userId, rating, STAR notes,\nstrength, weakness, improvement)
activate ReviewCtrl
ReviewCtrl -> ReviewSvc : mentorReview(request)
activate ReviewSvc

ReviewSvc -> SessionRepo : findById(sessionId)
activate SessionRepo
SessionRepo --> ReviewSvc : Session
deactivate SessionRepo

break Session, mentor or candidate is not found
    ReviewSvc --> ReviewCtrl : throws CustomException\n(404 NOT_FOUND, "Session | Mentor | User not found")
    ReviewCtrl --> ReviewPage : error response (404)
    ReviewPage --> Mentor : error response (404)
end

break Session is not completed yet
    ReviewSvc --> ReviewCtrl : throws CustomException\n(400 BAD_REQUEST, "Cannot review mentor for a session\nthat is not completed")
    ReviewCtrl --> ReviewPage : error response (400)
    ReviewPage --> Mentor : error response (400)
end

ReviewSvc -> ReviewRepo : save(MentorReview(session, mentor, candidate,\nrating and STAR notes))
activate ReviewRepo
ReviewRepo --> ReviewSvc : MentorReview
deactivate ReviewRepo

ReviewSvc -> ReviewSvc : checkAndCompleteRound(sessionId)
note right of ReviewSvc
  The round is only closed once both the mentor review and the
  candidate feedback exist (see 3.6.2.4 Post-Interview Mentor
  STAR Evaluation & Round Completion Trigger)
end note

ReviewSvc --> ReviewCtrl : MentorReview
deactivate ReviewSvc
ReviewCtrl --> ReviewPage : 200 OK (assessment is saved)
ReviewPage --> Mentor : 200 OK (assessment is saved)
deactivate ReviewCtrl

deactivate StudentPage
deactivate MentorPage
deactivate ReviewPage

@enduml
