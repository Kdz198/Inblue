@startuml ResetPasswordWithOtp
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 20

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

autonumber

actor "Guest" as User
participant ":ResetPasswordPage" as Client
participant ":AuthController" as Controller
participant ":PasswordResetServiceImpl" as Service
participant ":RedisTemplate" as Redis
participant ":UserRepository" as UserRepo
participant ":MentorRepository" as MentorRepo
participant ":PasswordEncoder" as Encoder

' ===================== Submit the OTP and the new password =====================

activate Client

User -> Client : POST /api/auth/reset-password\n(email, otp, newPassword)
Client -> Controller : POST /api/auth/reset-password\n(email, otp, newPassword)
activate Controller

Controller -> Service : resetPassword(email, otp, newPassword)
activate Service

break New password is empty
    Service --> Controller : throws CustomException\n(400 BAD_REQUEST, "New password must not be empty")
    Controller --> Client : error response (400)
    Client --> User : error response (400)
end

' ===================== Verify the OTP =====================

Service -> Redis : get("reset_password_otp:" + email)
activate Redis
Redis --> Service : saved OTP or nothing

break Saved OTP is missing or has expired
    Service --> Controller : throws CustomException\n(400 BAD_REQUEST, "OTP code has expired or does not exist. Please request a new one.")
    Controller --> Client : error response (400)
    Client --> User : error response (400)
end

break Submitted OTP does not match the saved OTP
    Service --> Controller : throws CustomException\n(400 BAD_REQUEST, "Invalid OTP code.")
    Controller --> Client : error response (400)
    Client --> User : error response (400)
end

' ===================== Update the account password =====================

Service -> UserRepo : findByEmail(email)
activate UserRepo
UserRepo --> Service : User or nothing

alt User account is found
    Service -> Encoder : encode(newPassword)
    activate Encoder
    Encoder --> Service : encoded password

    Service -> UserRepo : save(user with new password)
    UserRepo --> Service : saved user
    deactivate UserRepo
else User account is not found
    Service -> MentorRepo : findByEmail(email)
    activate MentorRepo
    MentorRepo --> Service : Mentor or nothing

    break Mentor account is not found
        Service --> Controller : throws CustomException\n(500 INTERNAL_SERVER_ERROR, "User not found after OTP verification.")
        Controller --> Client : error response (500)
        Client --> User : error response (500)
    end

    Service -> Encoder : encode(newPassword)
    Encoder --> Service : encoded password
    deactivate Encoder

    Service -> MentorRepo : save(mentor with new password)
    MentorRepo --> Service : saved mentor
    deactivate MentorRepo
end

' ===================== Invalidate the used OTP =====================

Service -> Redis : delete("reset_password_otp:" + email)
Redis --> Service : deleted
deactivate Redis

Service --> Controller : void
deactivate Service

Controller --> Client : 200 OK\n"Password has been reset successfully"
Client --> User : 200 OK\n"Password has been reset successfully"
deactivate Controller

deactivate Client

@enduml
