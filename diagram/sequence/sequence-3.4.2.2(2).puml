@startuml SubmitCodingProblemAutoJudge
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 20

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

actor "Candidate" as Candidate
participant ":ApplicationDetailController" as Controller
participant ":SubmissionService" as SubService
participant ":RoundProcessorFactory" as Factory
participant ":CodeRoundProcessor" as CodeProcessor
participant ":SubmissionEventHandle" as EventHandle
participant ":CodingProblemsRepository" as ProblemRepo
participant ":ApplicationDetailRepository" as DetailRepo
participant ":ApplicationServiceImpl" as AppService
participant ":ApiClientImpl" as ApiClient
participant "Compiler Service" as Compiler

note right of Compiler
  Python sandbox service that compiles
  and runs code (separate service,
  not part of the Spring Boot backend)
end note

Candidate -> Controller : POST /api/application-details/submit\n(applicationId, compileRequest[] with isTest = false)
activate Controller

Controller -> SubService : submitRound(submitRequest)
activate SubService

' ===================== Load current round and select processor =====================

ref over SubService : Load current application and round\n(see 3.4.2.1)

SubService -> Factory : getProcessor(currentRound.roundType)
activate Factory
Factory --> SubService : CodeRoundProcessor
deactivate Factory

SubService -> SubService : build ProcessDto(application, round,\ncompileRequest, roundType)

SubService -> CodeProcessor : process(processDto)
activate CodeProcessor

break Compile request list is missing or empty
    CodeProcessor --> SubService : throws IllegalArgumentException\n("Compile request must not be null or empty")
    SubService --> Controller : propagate exception
    Controller --> Candidate : error response (500)
end

' ===================== Official submission graded by hidden test cases =====================

CodeProcessor -> CodeProcessor : verify that no compile request is flagged as a test run

CodeProcessor -> EventHandle : processCodeSubmission(processDto)
activate EventHandle

EventHandle -> DetailRepo : findByApplicationIdAndRoundId(applicationId, roundId)
activate DetailRepo
DetailRepo --> EventHandle : Optional<ApplicationDetail>

break Round has already been submitted
    EventHandle --> CodeProcessor : throws CustomException\n(409 CONFLICT, "Round has already been submitted")
    CodeProcessor --> SubService : propagate exception
    SubService --> Controller : propagate exception
    Controller --> Candidate : error response (409)
end

loop Each compile request in the submission
    EventHandle -> ProblemRepo : findById(problemId)
    activate ProblemRepo
    ProblemRepo --> EventHandle : Optional<CodingProblem>
    deactivate ProblemRepo

    break Coding problem is not found
        EventHandle --> CodeProcessor : throws IllegalArgumentException\n("Coding problem not found with ID: {problemId}")
        CodeProcessor --> SubService : propagate exception
        SubService --> Controller : propagate exception
        Controller --> Candidate : error response (500)
    end

    EventHandle -> EventHandle : build test cases from hidden test cases and\naccumulate maximum possible score

    EventHandle -> EventHandle : build CompilerRequestDto(language, sourceCode, testCases,\ntime limit, memory limit, paramTypes, returnType)

    EventHandle -> ApiClient : executeCode(compilerRequestDto)
    activate ApiClient

    ApiClient -> Compiler : POST compile request\n(CompilerRequestDto)
    activate Compiler

    break Compiler service call fails
        ApiClient --> EventHandle : throws RuntimeException\n("Compiler service call failed")
        EventHandle --> CodeProcessor : propagate exception
        CodeProcessor --> SubService : propagate exception
        SubService --> Controller : propagate exception
        Controller --> Candidate : error response (500)
    end

    Compiler --> ApiClient : CompilerResponseDto (test case results)
    deactivate Compiler

    ApiClient --> EventHandle : CompilerResponseDto
    deactivate ApiClient

    opt Compiler service returned a response
        EventHandle -> EventHandle : add weight points of passed test cases to the score,\naccumulate passed tests, total tests, time and errors

        EventHandle -> EventHandle : add CodeSubmission(problemId, sourceCode, response)\nand append source code to textContent
    end
end

' ===================== Calculate result and save =====================

EventHandle -> EventHandle : normalize total score to a percentage\nof the maximum possible score

alt Final score reaches the pass threshold
    EventHandle -> EventHandle : set finalResult = PASSED
else Final score is below the pass threshold
    EventHandle -> EventHandle : set finalResult = FAILED
end

EventHandle -> EventHandle : build ApplicationDetail(status = COMPLETED,\naiScore, finalScore, finalResult, submissionData)

EventHandle -> DetailRepo : saveAndFlush(applicationDetail)
DetailRepo --> EventHandle : savedDetail
deactivate DetailRepo

' ===================== Advance application to the next round =====================

EventHandle -> AppService : moveToNextRound(application)
activate AppService

ref over AppService : Move application to the next round or\nfinish the application (see 3.4.2.1)

AppService --> EventHandle : void
deactivate AppService

EventHandle --> CodeProcessor : savedDetail
deactivate EventHandle

CodeProcessor -> CodeProcessor : SubmissionResult.completed(savedDetail)

CodeProcessor --> SubService : SubmissionResult (COMPLETED)
deactivate CodeProcessor

SubService --> Controller : SubmissionResult
deactivate SubService

Controller --> Candidate : 200 OK\nbody = SubmissionResult
deactivate Controller

@enduml
