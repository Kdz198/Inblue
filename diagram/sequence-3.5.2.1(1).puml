@startuml GenerateInterviewQuestionAudioWithTts
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 20

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

actor "Candidate" as Candidate
participant ":InterviewProcessController" as Controller
participant ":SpeechServiceImpl" as Service
participant ":StringRedisTemplate" as Redis
participant "ElevenLabs API" as ElevenLabs
participant "Google TTS" as GoogleTts

note right of ElevenLabs
  Third-party text-to-speech service
  (model eleven_turbo_v2_5)
end note

note right of GoogleTts
  Third-party fallback text-to-speech service
end note

' ===================== Request audio for the current question =====================

Candidate -> Controller : POST /api/v1/interview/tts\n(text, voiceId)
activate Controller

Controller -> Service : generateAudio(text, voiceId)
activate Service

Service -> Service : choose the requested voice or\nthe default configured voice

' ===================== Primary provider: ElevenLabs =====================

Service -> Redis : get("elevenlabs:bearer:token")
activate Redis
Redis --> Service : bearer token or nothing
deactivate Redis

alt Bearer token is available and ElevenLabs responds
    Service -> ElevenLabs : POST /v1/text-to-speech/{voiceId}\n(text, model_id, voice_settings)
    activate ElevenLabs
    ElevenLabs --> Service : audio/mpeg bytes
    deactivate ElevenLabs

' ===================== Fallback provider: Google TTS =====================

else Bearer token is missing or ElevenLabs request fails
    Service -> Service : split text into sentence chunks\nof at most 180 characters

    loop Each text chunk
        Service -> GoogleTts : GET /translate_tts\n(tl = vi, q = chunk)
        activate GoogleTts
        GoogleTts --> Service : audio chunk
        deactivate GoogleTts

        break Google TTS request fails
            Service --> Controller : throws RuntimeException\n("Google TTS fallback failed")
            Controller --> Candidate : error response (500)
        end

        Service -> Service : append chunk to the output audio
    end
end

Service --> Controller : audio bytes
deactivate Service

Controller --> Candidate : 200 OK\nbody = audio bytes (application/octet-stream)
deactivate Controller

@enduml
