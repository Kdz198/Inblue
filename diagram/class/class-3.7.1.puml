' ================= RELATIONSHIPS =================

' --- Application lifecycle & recruitment pipeline ---
ApplicationController .down.> ApplicationService : use
ApplicationServiceImpl .up.|> ApplicationService : implement
ApplicationServiceImpl .down.> ApplicationRepository : use
ApplicationServiceImpl .down.> JobDescriptionRepository : use
ApplicationServiceImpl .down.> ApplicationDetailRepository : use
ApplicationServiceImpl .down.> JdPurchaseRepository : use
ApplicationServiceImpl .down.> UserRepository : use
ApplicationServiceImpl .down.> SecurityUtils : use
ApplicationServiceImpl .down.> ApplicationEventPublisher : use
ApplicationServiceImpl .down.> JourneySummaryService : use
ApplicationServiceImpl .down.> JourneySummaryServiceImpl : use
ApplicationServiceImpl .down.> ApplicationDetailServiceProvider : use
ApplicationDetailServiceProvider .down.> ApplicationDetailService : use
ApplicationServiceImpl .down.> ApplicationLookupResponse : create
ApplicationServiceImpl .down.> ApplicationDetail : create
ApplicationRepository -up-|> JpaRepository : extend
Application .right.> ApplicationStatus : use
ApplicationLookupResponse .right.> ApplicationStatus : use

' --- Staff HR review & scoring ---
ApplicationDetailController .down.> ApplicationDetailService : use
ApplicationDetailServiceImpl .up.|> ApplicationDetailService : implement
ApplicationDetailServiceImpl .down.> ApplicationDetailRepository : use
ApplicationDetailServiceImpl .down.> ApplicationService : use
ApplicationDetailServiceImpl .down.> RoundRepository : use
ApplicationDetailServiceImpl .down.> JobDescriptionRepository : use
ApplicationDetailServiceImpl .down.> JwtUtils : use
ApplicationDetailServiceImpl .down.> ReviewerApplicationDetailResponseDto : create
ReviewerApplicationDetailResponseDto .down.> ApplicationDetailStatus : use
ReviewerApplicationDetailResponseDto .down.> MentorResponse : use
ReviewerApplicationDetailResponseDto .down.> Round : use

@enduml
