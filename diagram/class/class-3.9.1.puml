@startuml CompetencyReport_CommunityMessengerModule
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
hide circle

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55

' ================= CANDIDATE COMPETENCY REPORT & JOURNEY SUMMARY =================

class ApplicationController {
  - applicationService : ApplicationService
  - journeySummaryService : JourneySummaryService
  --
  + getJourneySummary(applicationId : Long) : JourneySummary
  + generateJourneySummary(applicationId : Long) : JourneySummary
  + getCompetencyChart(applicationId : Long) : CompetencyChartResponse
  .. (applyJd, getAllApplications, getApplicationsByEmail,
      getApplicationById, getAllApplicationsByUserId - see class-3.7.1) ..
}

note right of ApplicationController
  summary-audio/{email} endpoint (getAllJourneySummaryWithMissingAudio)
  supports the text-to-speech narration pipeline and is not
  part of this report's diagram scope
end note

interface JourneySummaryService {
  + generate(applicationId : Long) : JourneySummaryAIRequest
  + buildAIRequest(applicationId : Long) : JourneySummaryAIRequest
  + buildSummaryRequest(applicationId : Long) : AISummaryRequest
  + saveNarrative(applicationId : Long, narrative : String) : JourneySummary
  + getSavedSummary(applicationId : Long) : JourneySummary
  + getSavedCompetencyChart(applicationId : Long) : CompetencyChartResponse
  + generateMissingScripts() : void
  + getAllJourneyByUser(email : String) : List<JourneySummary>
}

class JourneySummaryServiceImpl {
  - summaryReportFallbackEnabled : boolean
  - applicationRepository : ApplicationRepository
  - jobDescriptionRepository : JobDescriptionRepository
  - applicationDetailRepository : ApplicationDetailRepository
  - roundRepository : RoundRepository
  - journeySummaryRepository : JourneySummaryRepository
  - userRepository : UserRepository
  - roundSummaryService : RoundSummaryService
  - competencyChartService : CompetencyChartService
  - apiClient : ApiClient
  --
  + generate(applicationId : Long) : JourneySummaryAIRequest
  + buildAIRequest(applicationId : Long) : JourneySummaryAIRequest
  + buildSummaryRequest(applicationId : Long) : AISummaryRequest
  + saveNarrative(applicationId : Long, narrative : String) : JourneySummary
  + getSavedSummary(applicationId : Long) : JourneySummary
  + getSavedCompetencyChart(applicationId : Long) : CompetencyChartResponse
  + generateMissingScripts() : void
  + getAllJourneyByUser(email : String) : List<JourneySummary>
  - saveAIResponse(applicationId : Long, request : JourneySummaryAIRequest,\nresponse : JourneySummaryAIResponse) : JourneySummary
  - saveFallbackSummary(applicationId : Long, request : JourneySummaryAIRequest,\ncause : Exception) : JourneySummary
  - enrichCompetencyChartMetadata(applicationId : Long, request : JourneySummaryAIRequest,\ncompetencyChart : CompetencyChartResponse) : void
  .. (buildFallbackNarrative, extractKeyRequirements,\nresolveRoundOrder - minor formatting helpers, omitted) ..
}

note right of JourneySummaryServiceImpl
  generate() calls the AnythingLLM SUMMARY_REPORT workspace; if it fails
  or the fallback flag is enabled, a fallback summary is built locally
  from CompetencyChartService instead of failing the request
end note

interface CompetencyChartService {
  + getCompetencyChart(applicationId : Long) : CompetencyChartResponse
}

class CompetencyChartServiceImpl {
  - applicationRepository : ApplicationRepository
  - applicationDetailRepository : ApplicationDetailRepository
  - jobDescriptionRepository : JobDescriptionRepository
  - roundRepository : RoundRepository
  - userRepository : UserRepository
  --
  + getCompetencyChart(applicationId : Long) : CompetencyChartResponse
  - buildTechnicalSkillAreas(contributions : List<RoundContribution>) : List<SkillAreaScore>
  - buildBehavioralSkills(contributions : List<RoundContribution>) : List<BehavioralSkillScore>
  - toCompetencyLevel(score : Double) : CompetencyLevel
  .. (buildContribution, resolveRawScore, normalizeScore, resolveOverallScore,
      average, sourceRounds, roundName, clamp - scoring helpers, omitted) ..
}

note right of CompetencyChartServiceImpl
  Each completed round contributes a normalized 0-100 score, mapped to a
  SWECOM skill area or behavioral skill via SwecomMappingConfig, then
  averaged per skill area/skill and converted to a CompetencyLevel
end note

class RoundSummaryService {
  - roundSummaryFactory : RoundSummaryFactory
  --
  + buildRoundSummary(detail : ApplicationDetail, roundConfig : Round) : AISummaryRequest.RoundSummaryInfo
}

class JourneySummary {
  - id : Long
  - applicationId : Long
  - narrative : String
  - competencyChart : CompetencyChartResponse
  - swecomAssessments : List<JourneySummaryAIResponse.SwecomSkillAssessment>
  - developmentRecommendations : List<JourneySummaryAIResponse.DevelopmentRecommendation>
  - generatedAt : LocalDateTime
  - createdAt : LocalDateTime
  - script : String
  - audioUrl : String
}

interface JourneySummaryRepository {
  + findTopByApplicationIdOrderByGeneratedAtDesc(applicationId : Long) : Optional<JourneySummary>
  + findByScriptIsNull() : List<JourneySummary>
  + findByAudioUrlIsNullAndScriptIsNotNull() : List<JourneySummary>
  + findAllByApplicationIdIn(applicationIds : Collection<Long>) : List<JourneySummary>
}

class CompetencyChartResponse {
  - applicationId : Long
  - candidateName : String
  - jobTitle : String
  - overallLevel : CompetencyLevel
  - overallScore : Double
  - technicalSkillAreas : List<SkillAreaScore>
  - behavioralSkills : List<BehavioralSkillScore>
}

class SkillAreaScore {
  - skillArea : String
  - score : Double
  - level : CompetencyLevel
  - sourceRounds : List<String>
}

class BehavioralSkillScore {
  - skillName : String
  - score : Double
  - sourceRounds : List<String>
}

enum CompetencyLevel {
  TECHNICIAN
  ENTRY_LEVEL_PRACTITIONER
  PRACTITIONER
  TECHNICAL_LEADER
  SENIOR_SOFTWARE_ENGINEER
}

class JourneySummaryAIRequest {
  - data : AISummaryRequest
}

class AISummaryRequest {
  - jobDescription : AISummaryRequest.JobDescriptionDto
  - roundSummaries : List<AISummaryRequest.RoundSummaryInfo>
  --
  + toPromptText() : String
}

class "AISummaryRequest.JobDescriptionDto" as JobDescriptionDto {
  - title : String
  - level : String
  - keyRequirements : List<String>
}

class "AISummaryRequest.RoundSummaryInfo" as RoundSummaryInfo {
  - roundName : String
  - roundType : RoundType
  - roundOrder : Integer
  - score : Double
  - maxScore : Double
  - finalResult : String
  - summary : String
  - strengths : List<String>
  - weaknesses : List<String>
  - hrNote : String
  - hrScore : Double
}

class JourneySummaryAIResponse {
  - narrative : String
  - competencyChart : CompetencyChartResponse
  - swecomAssessments : List<JourneySummaryAIResponse.SwecomSkillAssessment>
  - developmentRecommendations : List<JourneySummaryAIResponse.DevelopmentRecommendation>
}

class "JourneySummaryAIResponse.SwecomSkillAssessment" as SwecomSkillAssessment {
  - skillArea : String
  - level : CompetencyLevel
  - score : Double
  - evidenceSummary : String
  - sourceRounds : List<String>
}

class "JourneySummaryAIResponse.DevelopmentRecommendation" as DevelopmentRecommendation {
  - targetSkillArea : String
  - recommendation : String
  - targetLevel : CompetencyLevel
}

' ================= COMMUNITY BLOG & FEED (POST, LIKE, COMMENT) =================

class PostController {
  - postService : PostService
  --
  + createPost(postCreateRequest : PostCreateRequest) : Post
  + getNewFeed(page : int, size : int) : Page<PostResponse>
  + getPostById(postId : int) : PostResponse
  + likePost(request : PostLikeRequest) : PostLike
  + unlikePost(postId : int) : Map<String, String>
  + checkLiked(postId : int) : Map<String, String>
  + createComment(request : PostCommentRequest) : PostComment
  + updateComment(commentId : int, body : Map<String, String>) : PostComment
  + deleteComment(commentId : int) : void
  + getAllPosts() : List<PostResponse>
  + getPublishedPosts() : List<PostResponse>
  + changeStatus(postId : int, status : PostStatus) : Map<String, String>
}

note right of PostController
  changeStatus(postId, status) is also the endpoint behind report
  section 3.7.11 Admin Community Post Moderation: Staff/Admin sets a
  post to PUBLISHED or ARCHIVED to moderate the community feed
end note

interface PostService {
  + createPost(post : PostCreateRequest) : Post
  + getPostByPostId(postId : int) : PostResponse
  + changeStatus(postId : int, status : PostStatus) : void
  + getPublishPost() : List<PostResponse>
  + getAllPost() : List<PostResponse>
  + getNewFeed(page : int, size : int) : Page<PostResponse>
  + likePost(request : PostLikeRequest) : PostLike
  + unlikePost(postId : int) : void
  + isLiked(postId : int) : boolean
  + createComment(request : PostCommentRequest) : PostComment
  + updateComment(commentId : int, content : String) : PostComment
  + deleteComment(commentId : int) : void
}

class PostServiceImpl {
  - postMapper : PostMapper
  - postRepository : PostRepository
  - mentorRepository : MentorRepository
  - cloudinaryService : CloudinaryService
  - userService : UserService
  - securityUtils : SecurityUtils
  --
  + createPost(post : PostCreateRequest) : Post
  + changeStatus(postId : int, status : PostStatus) : void
  + getPublishPost() : List<PostResponse>
  + getPostByPostId(postId : int) : PostResponse
  + getAllPost() : List<PostResponse>
  + getNewFeed(page : int, size : int) : Page<PostResponse>
  + likePost(request : PostLikeRequest) : PostLike
  + unlikePost(postId : int) : void
  + isLiked(postId : int) : boolean
  + createComment(request : PostCommentRequest) : PostComment
  + updateComment(commentId : int, content : String) : PostComment
  + deleteComment(commentId : int) : void
  - getPostById(postId : int) : Post
  - mapPostToResponse(posts : List<Post>) : List<PostResponse>
  - resolveCurrentActor() : Actor
  - resolveActor(actorId : int, role : Role) : Actor
  - isSameActor(like : PostLike, actor : Actor) : boolean
  .. (mapPostAuthor, mapLikeToResponse, mapCommentToResponse -
      per-DTO mapping helpers, omitted) ..
}

class "PostServiceImpl.Actor" as Actor {
  - user : User
  - mentor : Mentor
}

note right of Actor
  Either a User or a Mentor, never both - the current
  author/liker/commenter is resolved once per request
  from the authenticated role (USER or MENTOR)
end note

class Post {
  - postId : int
  - title : String
  - content : String
  - summary : String
  - status : PostStatus
  - author : User
  - authorMentor : Mentor
  - creationDate : Instant
  - lastModifiedDate : Instant
  - coverImgUrl : String
  - public_id : String
  - tags : List<String>
  - likes : List<PostLike>
  - comments : List<PostComment>
}

class PostComment {
  - id : int
  - user : User
  - mentor : Mentor
  - content : String
  - parentCommentId : int
  - createdAt : Timestamp
  - updatedAt : Timestamp
}

class PostLike {
  - id : int
  - user : User
  - mentor : Mentor
  - createdAt : Timestamp
}

note right of PostLike
  Unique constraint on (post_id, user_id) and (post_id, mentor_id)
  prevents the same user or mentor from liking a post twice
end note

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

interface PostRepository {
  + findAllByStatus(status : PostStatus) : List<Post>
  + findAllByOrderByCreationDateDesc(pageable : Pageable) : Page<Post>
}

