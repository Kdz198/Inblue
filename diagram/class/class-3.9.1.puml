  - userAvatar : String
}

' ================= DIRECT MESSENGER CHAT (CANDIDATE <-> MENTOR) =================

class ChatController {
  - chatService : ChatService
  --
  + processMessage(message : ChatDto) : void
}

note right of ChatController
  STOMP @MessageMapping("/chat") handler: invoked when a client
  sends a message over the /ws-chat WebSocket connection
end note

class ChatMessageController {
  - chatService : ChatService
  --
  + getChatHistory(currentFullId : String, recipientFullId : String) : List<ChatMessage>
  + getContacts(myId : int, role : Role) : List<Integer>
}

interface ChatService {
  + processMessage(message : ChatDto) : void
  + getChatHistory(senderId : String, recipientId : String) : List<ChatMessage>
  + findAllContact(myId : int, role : Role) : List<Integer>
}

class ChatServiceImpl {
  - chatMessageRepository : ChatMessageRepository
  - messagingTemplate : SimpMessagingTemplate
  --
  + processMessage(message : ChatDto) : void
  + getChatHistory(senderId : String, recipientId : String) : List<ChatMessage>
  + findAllContact(myId : int, role : Role) : List<Integer>
  + parseId(id : String) : int
  + getType(id : String) : String
}

note right of ChatServiceImpl
  senderId/recipientId are "TYPE_id" strings (e.g. "USER_12",
  "MENTOR_5"); parseId/getType split them into the numeric id
  and actor type stored on ChatMessage
end note

class ChatMessage {
  - id : int
  - senderId : int
  - senderType : String
  - recipientId : int
  - recipientType : String
  - content : String
  - timestamp : Timestamp
}

interface ChatMessageRepository {
  + getHistory(id1 : int, type1 : String, id2 : int, type2 : String) : List<ChatMessage>
  + findPartnerIds(myId : int, myType : String) : List<Integer>
}

class ChatDto {
  - senderId : String
  - recipientId : String
  - content : String
}

class WebSocketConfig {
  + registerStompEndpoints(registry : StompEndpointRegistry) : void
  + configureMessageBroker(registry : MessageBrokerRegistry) : void
}

note right of WebSocketConfig
  Registers the /ws-chat SockJS endpoint and enables a simple
  broker on /topic (group) and /user (private, per-recipient) prefixes
end note

