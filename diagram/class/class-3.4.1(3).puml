@startuml AssessmentEngine_RoundSubmissionEngine
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
hide circle

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55


' ================= ROUND SUBMISSION ENGINE (Strategy + Factory) =================
' Note: CODE_REVIEW is NOT routed through this engine - it is graded directly
' by SubmissionService.evaluateCodeReview() (see CODE REVIEW EVALUATION section).

interface RoundSubmissionProcessor {
  + getSupportedType() : RoundType
  + process(detail : ProcessDto) : SubmissionResult
}

class RoundProcessorFactory {
  - quizProcessor : QuizRoundProcessor
  - emailProcessor : EmailRoundProcessor
  - cvProcessor : CVRoundProcessor
  - codeProcessor : CodeRoundProcessor
  --
  + getProcessor(type : RoundType) : RoundSubmissionProcessor
}

class QuizRoundProcessor {
  - roundRepository : RoundRepository
  - applicationDetailRepository : ApplicationDetailRepository
  - applicationService : ApplicationService
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
}

class CodeRoundProcessor {
  - apiClient : ApiClient
  - codingProblemsRepository : CodingProblemsRepository
  - submissionEventHandle : SubmissionEventHandle
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
  .. (isTest=true -> compiles against visible examples only, no persistence;
      isTest=false -> delegates to SubmissionEventHandle.processCodeSubmission) ..
}

class EmailRoundProcessor {
  - applicationEventPublisher : ApplicationEventPublisher
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
}

class CVRoundProcessor {
  - submissionEventHandle : SubmissionEventHandle
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
  .. (CV parsing/matching detail in AI CV Parsing & Job Description
      Matching Module diagram) ..
}

class ApplicationEventPublisher <<external library>> {
  + publishEvent(event : Object) : void
}

