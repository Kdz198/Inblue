' ================= TAKING THE ENTRY TEST =================

class EntryTestController {
  - entryTestService : EntryTestService
  - securityUtils : SecurityUtils
  - responseMapper : EntryTestResponseMapper
  --
  + startEntryTest() : EntryTestStartResponse
  + runCode(attemptId : Long, request : EntryTestRunCodeRequest) : CompilerResponseDto
  + submitEntryTest(attemptId : Long, request : EntryTestSubmitRequest) : EntryTestAttemptResponse
  + getAttemptResult(attemptId : Long) : EntryTestAttemptResponse
}

interface EntryTestService {
  + startEntryTest(userId : Integer) : EntryTestStartResponse
  + runCode(userId : Integer, attemptId : Long, request : EntryTestRunCodeRequest) : CompilerResponseDto
  + submitEntryTest(userId : Integer, attemptId : Long, request : EntryTestSubmitRequest) : EntryTestAttempt
  + getAttempt(userId : Integer, attemptId : Long) : EntryTestAttempt
}

class EntryTestServiceImpl {
  - entryTestRepository : EntryTestRepository
  - attemptRepository : EntryTestAttemptRepository
  - preferenceRepository : UserCareerPreferenceRepository
  - questionBankRepository : QuestionBankRepository
  - codingProblemsRepository : CodingProblemsRepository
  - apiClient : ApiClient
  - userCompetencyService : UserCompetencyService
  - userRepository : UserRepository
  - responseMapper : EntryTestResponseMapper
  --
  + startEntryTest(userId : Integer) : EntryTestStartResponse
  + runCode(userId : Integer, attemptId : Long, request : EntryTestRunCodeRequest) : CompilerResponseDto
  + submitEntryTest(userId : Integer, attemptId : Long, request : EntryTestSubmitRequest) : EntryTestAttempt
  + getAttempt(userId : Integer, attemptId : Long) : EntryTestAttempt
  - getOrCreateActiveEntryTest() : EntryTest
  - pickCommonQuestions(config : EntryTest.EntryTestSectionConfig) : List<QuestionItemSnapshot>
  - pickSpecificQuestions(config, targetRole, languages) : List<QuestionItemSnapshot>
  - pickSpecificCodingProblems(config, targetRole, languages) : List<CodingProblemItemSnapshot>
  .. (gradeQuestionAnswer, gradeCodingAnswer, validateSubmittedAnswers,
      buildResultSnapshot - grading/validation helpers, omitted) ..
}

note right of EntryTestServiceImpl
  startEntryTest snapshots the picked questions/coding problems into
  the attempt itself (commonQuizItemsJson, specificQuizItemsJson,
  specificCodingItemsJson) so later grading never re-queries the
  question bank - it grades against the frozen snapshot instead
end note

