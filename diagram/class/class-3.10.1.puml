' ================= COMPETENCY EVALUATION & LEVEL SCALE =================

class UserCompetencyController {
  - userCompetencyService : UserCompetencyService
  - securityUtils : SecurityUtils
  - competencyMapper : UserCompetencyMapper
  --
  + getCurrentCompetency() : UserCompetencyResponse
}

interface UserCompetencyService {
  + updateAfterEntryTest(attempt : EntryTestAttempt) : UserCompetency
  + getCurrentCompetency(userId : Integer) : UserCompetency
  + updateAfterJd(userId : Integer, jdScore : Double) : UserCompetency
  + resolveLevelName(attempt : EntryTestAttempt) : String
}

class UserCompetencyServiceImpl {
  - competencyRepository : UserCompetencyRepository
  - preferenceRepository : UserCareerPreferenceRepository
  - levelScaleRepository : LevelScaleRepository
  --
  + updateAfterEntryTest(attempt : EntryTestAttempt) : UserCompetency
  + resolveLevelName(attempt : EntryTestAttempt) : String
  + getCurrentCompetency(userId : Integer) : UserCompetency
  + updateAfterJd(userId : Integer, jdScore : Double) : UserCompetency
  - resolveLevel(role : TargetRole, finalScore : double, codingScore : double) : TargetLevel
  - buildSnapshot(attempt : EntryTestAttempt, level : TargetLevel) : Map<String, Object>
}

note right of UserCompetencyServiceImpl
  resolveLevel picks the highest-minScore LevelScale whose range
  contains finalScore (role-specific scale takes precedence over a
  role-agnostic one, since both are filtered in first) and whose
  minCodingScore, if set, the candidate's coding score also clears
end note

note bottom of UserCompetencyServiceImpl
  updateAfterJd is defined for re-evaluating competency from a later
  JD-round score (70% previous score + 30% JD score) but is not yet
  called from anywhere else in the codebase
end note

