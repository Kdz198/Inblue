}

class UpsertLevelScaleRequest {
  - targetRole : TargetRole
  - level : TargetLevel
  - minScore : Double
  - maxScore : Double
  - minCodingScore : Double
  - isActive : Boolean
}

class UpsertLevelScaleSetRequest {
  - targetRole : TargetRole
  - scales : List<UpsertLevelScaleRequest>
}

class LevelScale {
  - id : Long
  - targetRole : TargetRole
  - level : TargetLevel
  - minScore : Double
  - maxScore : Double
  - minCodingScore : Double
  - isActive : Boolean
  - createdAt : LocalDateTime
  - updatedAt : LocalDateTime
}

note right of LevelScale
  targetRole = null means the scale applies to every role (a
  role-agnostic fallback); upsertLevelScaleSet replaces a whole
  role's (or the role-agnostic) set of levels in one call
end note

interface LevelScaleRepository {
  + findAllByIsActiveTrue() : List<LevelScale>
  + findAllByTargetRole(targetRole : TargetRole) : List<LevelScale>
  + findAllByTargetRoleIsNull() : List<LevelScale>
}

