  + upsertPreference(userId : Integer, request : UpsertCareerPreferenceRequest) : UserCareerPreference
  + skipPreference(userId : Integer) : UserCareerPreference
}

class CareerPreferenceServiceImpl {
  - preferenceRepository : UserCareerPreferenceRepository
  - embeddingService : EmbeddingService
  --
  + getCurrentPreference(userId : Integer) : UserCareerPreference
