note right of UserCareerPreference
  userId is both the primary key and the FK to User.id (1:1 by
  shared key) - the entity holds no direct object reference to User
end note

interface UserCareerPreferenceRepository {
  + findByUserIdAndIsActiveTrue(userId : Integer) : Optional<UserCareerPreference>
