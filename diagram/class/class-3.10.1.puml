class UpsertCareerPreferenceRequest {
  - targetRole : TargetRole
  - languagesJson : List<String>
  - careerGoal : String
  - targetLevel : TargetLevel
}

class UserCareerPreference {
  - userId : Integer
  - targetRole : TargetRole
  - skills : List<String>
  - skillEmbedding : float[]
  - careerGoal : String
  - targetLevel : TargetLevel
  - needRetest : Boolean
