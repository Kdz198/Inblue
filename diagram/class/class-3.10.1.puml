}

note bottom of EntryTestSectionConfig
  SectionType: COMMON_QUIZ, SPECIFIC_QUIZ, SPECIFIC_CODING
  ItemType: QUESTION_BANK, CODING_PROBLEM
end note

interface EntryTestRepository {
  + findFirstByIsActiveTrueOrderByUpdatedAtDesc() : Optional<EntryTest>
