@startuml CreatePayOSPaymentQRCode_ApplicationCheckout
skinparam monochrome true
skinparam shadowing false

' Do not repeat participant boxes at the bottom of the diagram
hide footbox

<style>
sequenceDiagram {
  groupHeader {
    FontStyle plain
  }
}
</style>

actor "Candidate" as Candidate
participant ":PaymentController" as Controller
participant ":PaymentServiceImpl" as Service
participant ":SecurityUtils" as SecUtils
participant ":HelperUtil" as Helper
participant ":JwtUtils" as Jwt
participant ":JobDescriptionRepository" as JdRepo
participant ":UserRepository" as UserRepo
participant ":PaymentRepository" as PaymentRepo
participant ":PayOS" as PayOS
participant "PayOS Payment Gateway" as PayOSGateway

note right of PayOS
  vn.payos.PayOS SDK client
  (third-party library, not
  custom application code)
end note

Candidate -> Controller : POST /api/payments/pay?jdId={jdId}
activate Controller

Controller -> Service : createPayment(jdId)
activate Service

' ===================== Resolve current user from JWT =====================

Service -> SecUtils : getCurrentUserId()
activate SecUtils

SecUtils -> Helper : getToke()
activate Helper
Helper --> SecUtils : token : String

alt [Authorization token is present]
    SecUtils -> Jwt : getUserIdFromToken(token)
    activate Jwt
    Jwt --> SecUtils : userId : int
    deactivate Jwt

    SecUtils --> Service : userId

    ' ===================== Load Job Description & validate price =====================

    Service -> JdRepo : findById(jdId)
    activate JdRepo
    JdRepo --> Service : Optional<JobDescription>
    deactivate JdRepo

    alt [Job description is found]
        alt [Job description price is valid]
            Service -> Service : amount = jd.getPrice()

            Service -> Helper : generateUniqueOrderCode()
            Helper --> Service : orderCode : long
            deactivate Helper

            Service -> Service : transactionCode = Long.parseLong("100" + orderCode)

            ' ===================== Load User & persist pending Payment =====================

            Service -> UserRepo : findById(userId)
            activate UserRepo
            UserRepo --> Service : Optional<User>
            deactivate UserRepo

            alt [User is found]
                Service -> Service : build Payment(amount, user,\nstatus=PENDING, transactionCode, jdId)

                Service -> PaymentRepo : save(payment)
                activate PaymentRepo
                PaymentRepo --> Service : payment
                deactivate PaymentRepo

                ' ===================== Create PayOS payment link (QR checkout) =====================

                Service -> Service : createPayOSPayment(amount, transactionCode)

                Service -> Service : build CreatePaymentLinkRequest(\namount, orderCode=transactionCode,\ndescription="PAYMENT", returnUrl, cancelUrl)

                Service -> PayOS : paymentRequests().create(request)
                activate PayOS

                PayOS -> PayOSGateway : POST create payment link\n(amount, orderCode, description,\nreturnUrl, cancelUrl)
                activate PayOSGateway
                PayOSGateway -> PayOSGateway : generate order & QR checkout data
                PayOSGateway --> PayOS : response (checkoutUrl, qrCode, ...)
                deactivate PayOSGateway

                PayOS --> Service : CreatePaymentLinkResponse
                deactivate PayOS

                Service -> Service : return checkoutUrl : String

                Service --> Controller : checkoutUrl : String

                Controller --> Candidate : 200 OK\nbody = checkoutUrl
            else [User is not found]
                Service --> Controller : throws CustomException\n(404 NOT_FOUND, "User not found")

                Controller --> Candidate : error response (404)
            end
        else [Job description price is missing or invalid]
            Service --> Controller : throws CustomException\n(400 BAD_REQUEST,\n"This JD has no price yet. Please contact admin.")

            Controller --> Candidate : error response (400)
        end
    else [Job description is not found]
        Service --> Controller : throws CustomException\n(404 NOT_FOUND, "Job Description not found")

        Controller --> Candidate : error response (404)
    end
else [Authorization token is missing]
    SecUtils --> Service : throws CustomException\n(401 UNAUTHORIZED, "Missing Authorization token")
    deactivate SecUtils
    Service --> Controller : propagate exception
    deactivate Service
    Controller --> Candidate : error response (401)
    deactivate Controller
end

@enduml
