@startuml AssessmentEngine_AiScoringCompiler
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
hide circle

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55


' ================= AI-SCORING EVENT HANDLER (shared by CV, Coding, Email) =================

class SubmissionEventHandle {
  - jobDescriptionRepository : JobDescriptionRepository
  - apiClient : ApiClient
  - cloudinaryService : CloudinaryService
  - applicationDetailRepository : ApplicationDetailRepository
  - codingProblemsRepository : CodingProblemsRepository
  - applicationService : ApplicationService
  - emailSubmissionRepository : EmailSubmissionRepository
  - userService : UserService
  --
  + handleEventSubmission(dto : ProcessDto) : void
  + processCodeSubmission(dto : ProcessDto) : ApplicationDetail
  + processCvSubmission(dto : ProcessDto) : ApplicationDetail
  + processEmailSubmissionSync(dto : ProcessDto, submission : EmailSubmission) : void
  - processEmailSubmission(dto : ProcessDto) : void
  - gradeEmailSubmission(dto : ProcessDto, submission : EmailSubmission) : void
  - ensureRoundHasNotBeenSubmitted(dto : ProcessDto) : void
  - saveApplicationDetail(applicationDetail : ApplicationDetail) : ApplicationDetail
  + parseRawMetrics(rawMap : Map<String, Object>) : ApplicationDetail.AiFeedback {static}
}

interface ApiClient {
  + callApi(targetService : PythonService, endpoint : String, method : HttpMethod, requestBody : Object, responseType : Class<T>) : T
  + sendChatToAnythingLlm(workspace : AnythingLlmWorkspace, payload : Object, sessionId : String, reset : boolean, files : List<MultipartFile>, responseType : Class<T>) : T
  + executeCode(request : CompilerRequestDto) : CompilerResponseDto
  + connectWebSocket(targetService : PythonService, endpoint : String, onMessage : Consumer<String>, onError : Consumer<Throwable>) : WebSocket
}

class CompilerRequestDto {
  - language : CompilerLanguage
  - sourceCode : List<String>
  - timeLimitMs : int
  - memoryLimitMb : int
  - paramTypes : List<String>
  - returnType : String
  - testCases : List<CompilerRequestDto.TestCase>
}

class "CompilerRequestDto.TestCase" as CompilerRequestTestCase {
  - inputs : List<String>
  - expectedOutput : String
}

class CompilerResponseDto {
  - status : String
  - passedTestCases : int
  - totalTestCases : int
  - executionTimeMs : long
  - errorMessage : String
  - testCases : List<CompilerResponseDto.TestCaseResult>
}

class "CompilerResponseDto.TestCaseResult" as CompilerTestCaseResult {
  - index : int
  - status : String
  - input : String
  - expectedOutput : String
  - actualOutput : String
  - executionTimeMs : long
  - errorMessage : String
}

enum CompilerLanguage {
  JAVA
  PYTHON
  JS
  CPP
  CSHARP
  C
  TYPESCRIPT
  GO
  KOTLIN
  SWIFT
  RUST
  RUBY
  PHP
  DART
  SCALA
  ELIXIR
  ERLANG
  RACKET
}

