' ================= SUBMISSION ENTRY POINT =================

class ApplicationDetailController {
  - submissionService : SubmissionService
  - applicationDetailService : ApplicationDetailService
  --
  + submitApplicationDetail(submitRequest : SubmitRequest) : SubmissionResult
  + evaluateCodeReview(request : CodeReviewSubmitRequest) : ApplicationDetail
  + hrScore(applicationDetailId : int, isPass : boolean, note : String, score : double) : void
  + getApplicationDetailById(id : long) : ApplicationDetail
  + getApplicationDetailsByApplicationId(applicationId : long) : List<ApplicationDetail>
  + getApplicationDetailsForReviewer() : List<ReviewerApplicationDetailResponseDto>
  .. (Mentor Review scheduling endpoints: assignMentor, selectMentor,
      scheduleDecision, cancelSchedule... see Mentor Review Module diagram) ..
}

class SubmissionService {
  - roundProcessorFactory : RoundProcessorFactory
  - applicationService : ApplicationService
  - jobDescriptionService : JobDescriptionService
  - apiClient : ApiClient
  - applicationDetailRepository : ApplicationDetailRepository
  - submissionEventHandle : SubmissionEventHandle
  --
  + evaluateCodeReview(request : CodeReviewSubmitRequest) : ApplicationDetail
  + submitRound(detail : SubmitRequest) : SubmissionResult
  + submitEmailRoundSync(detail : SubmitRequest, emailSubmission : EmailSubmission) : void
}

interface ApplicationDetailService {
  + getApplicationDetailById(id : long) : ApplicationDetail
  + getByApplicationId(applicationId : long) : List<ApplicationDetail>
  + hrScore(applicationDetailId : long, isPass : boolean, note : String, score : double) : void
  + getApplicationDetailsForReviewer() : List<ReviewerApplicationDetailResponseDto>
  .. (assignMentor, selectMentor, scheduleDecision, cancelSchedule,
      startAiInterview... see Mentor Review / AI Interview Module diagrams) ..
}

class ApplicationDetailServiceImpl {
  - applicationDetailRepository : ApplicationDetailRepository
  - applicationService : ApplicationService
  --
  + getApplicationDetailById(id : long) : ApplicationDetail
  + getByApplicationId(applicationId : long) : List<ApplicationDetail>
  + hrScore(applicationDetailId : long, isPass : boolean, note : String, score : double) : void
  + getApplicationDetailsForReviewer() : List<ReviewerApplicationDetailResponseDto>
  .. (also depends on Mentor/InterviewSession/Session services for the
      methods above - see Mentor Review & AI Interview Module diagrams) ..
}

class SubmitRequest {
  - applicationId : Long
  - textContent : String
  - file : MultipartFile
  - quizAnswers : List<String>
  - compileRequest : List<CompileRequest>
}

class CompileRequest {
  - problemId : Long
  - language : CompilerLanguage
  - sourceCode : List<String>
  - isTest : Boolean
}

class ProcessDto {
  - application : Application
  - round : Round
  - textContent : String
  - file : MultipartFile
  - quizAnswers : List<String>
  - roundType : RoundType
  - compileRequest : List<CompileRequest>
}

class SubmissionResult {
  - status : Status
  - applicationId : Long
  - detail : ApplicationDetail
  - message : String
  - roundResult : ApplicationDetail.RoundResult
  - testCases : List<CompilerResponseDto.TestCaseResult>
  --
  + completed(detail : ApplicationDetail) : SubmissionResult {static}
  + pending(applicationId : Long) : SubmissionResult {static}
  + compileCode(compilerResponse : CompilerResponseDto) : SubmissionResult {static}
}

enum "SubmissionResult.Status" as SubmissionResultStatus {
  PENDING
  COMPLETED
}

' ================= ROUND SUBMISSION ENGINE (Strategy + Factory) =================
' Note: CODE_REVIEW is NOT routed through this engine - it is graded directly
' by SubmissionService.evaluateCodeReview() (see CODE REVIEW EVALUATION section).

interface RoundSubmissionProcessor {
  + getSupportedType() : RoundType
  + process(detail : ProcessDto) : SubmissionResult
}

class RoundProcessorFactory {
  - quizProcessor : QuizRoundProcessor
  - emailProcessor : EmailRoundProcessor
  - cvProcessor : CVRoundProcessor
  - codeProcessor : CodeRoundProcessor
  --
  + getProcessor(type : RoundType) : RoundSubmissionProcessor
}

class QuizRoundProcessor {
  - roundRepository : RoundRepository
  - applicationDetailRepository : ApplicationDetailRepository
  - applicationService : ApplicationService
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
}

class CodeRoundProcessor {
  - apiClient : ApiClient
  - codingProblemsRepository : CodingProblemsRepository
  - submissionEventHandle : SubmissionEventHandle
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
  .. (isTest=true -> compiles against visible examples only, no persistence;
      isTest=false -> delegates to SubmissionEventHandle.processCodeSubmission) ..
}

class EmailRoundProcessor {
  - applicationEventPublisher : ApplicationEventPublisher
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
}

class CVRoundProcessor {
  - submissionEventHandle : SubmissionEventHandle
  --
  + getSupportedType() : RoundType
  + process(dto : ProcessDto) : SubmissionResult
  .. (CV parsing/matching detail in AI CV Parsing & Job Description
      Matching Module diagram) ..
}

class ApplicationEventPublisher <<external library>> {
  + publishEvent(event : Object) : void
}

